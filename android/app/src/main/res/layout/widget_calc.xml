<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Display: tap to open the full app -->
    <LinearLayout
        android:id="@+id/calc_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/display_bg"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/calc_from_code"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.1"
                android:text="JPY → USD"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/calc_refresh"
                android:layout_width="40dp"
                android:layout_height="30dp"
                android:contentDescription="@string/widget_refresh"
                android:gravity="center"
                android:text="↻"
                android:textColor="@color/gold"
                android:textSize="17sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/calc_from"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:text="¥10,000"
            android:textColor="@color/fg" />

        <TextView
            android:id="@+id/calc_to"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginEnd="8dp"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-light"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:text="$63.61"
            android:textColor="@color/gold" />

        <TextView
            android:id="@+id/calc_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:gravity="end"
            android:maxLines="1"
            android:text="$1 = ¥157.20"
            android:textColor="@color/muted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Keypad -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout style="@style/WidgetKeyRow">
            <TextView android:id="@+id/k7" style="@style/WidgetKey" android:text="7" />
            <TextView android:id="@+id/k8" style="@style/WidgetKey" android:text="8" />
            <TextView android:id="@+id/k9" style="@style/WidgetKey" android:text="9" />
            <TextView android:id="@+id/k_back" style="@style/WidgetKey" android:contentDescription="Delete" android:text="⌫" android:textColor="@color/muted" />
        </LinearLayout>

        <LinearLayout style="@style/WidgetKeyRow">
            <TextView android:id="@+id/k4" style="@style/WidgetKey" android:text="4" />
            <TextView android:id="@+id/k5" style="@style/WidgetKey" android:text="5" />
            <TextView android:id="@+id/k6" style="@style/WidgetKey" android:text="6" />
            <TextView android:id="@+id/k_clear" style="@style/WidgetKey" android:contentDescription="Clear" android:text="C" android:textColor="@color/muted" />
        </LinearLayout>

        <LinearLayout style="@style/WidgetKeyRow">
            <TextView android:id="@+id/k1" style="@style/WidgetKey" android:text="1" />
            <TextView android:id="@+id/k2" style="@style/WidgetKey" android:text="2" />
            <TextView android:id="@+id/k3" style="@style/WidgetKey" android:text="3" />
            <TextView android:id="@+id/k_swap" style="@style/WidgetKey" android:contentDescription="Swap currencies" android:text="⇅" android:textColor="@color/gold" />
        </LinearLayout>

        <LinearLayout style="@style/WidgetKeyRow">
            <TextView android:id="@+id/k000" style="@style/WidgetKey" android:layout_weight="2" android:text="000" />
            <TextView android:id="@+id/k0" style="@style/WidgetKey" android:text="0" />
            <TextView android:id="@+id/k_dot" style="@style/WidgetKey" android:contentDescription="Decimal point, dollars only" android:text="." android:textColor="@color/line" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
